# Local open-weight model via Ollama (default for HarnessTest)
HARNESSTEST_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_API_KEY=ollama-local
HARNESSTEST_LOCAL_STEPS=5
HARNESSTEST_OLLAMA_TIMEOUT=120
HARNESSTEST_OPENCLAW_TIMEOUT=480
HARNESSTEST_OPENCLAW_RETRIES=2

# Optional cloud keys only if driving OpenClaw/Hermes/NemoClaw/DeepSeek against hosted APIs
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=

# Optional harness roots / overrides
# OPENCLAW_MODEL=
# HERMES_MODEL=
# NEMOCLAW_MODEL=
# NEMOCLAW_SANDBOX=harnesstest
# DEEPSEEK_HARNESS_ROOT=

# Local open-weight model via Ollama (default for HarnessTest)
HARNESSTEST_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_API_KEY=ollama-local
HARNESSTEST_LOCAL_STEPS=5
HARNESSTEST_OLLAMA_TIMEOUT=120
HARNESSTEST_OPENCLAW_TIMEOUT=900
HARNESSTEST_OPENCLAW_RETRIES=1
HARNESSTEST_OPENCLAW_CTX=8192
# HARNESSTEST_DEEPSEEK_RETRIES=2
# HARNESSTEST_RUNTIME=/tmp/harnesstest-runtime

# Optional cloud keys only if driving OpenClaw/Hermes/NemoClaw/DeepSeek against hosted APIs
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=

# Optional harness roots / overrides
# OPENCLAW_MODEL=
# HERMES_MODEL=
# NEMOCLAW_PROVIDER=ollama
# NEMOCLAW_MODEL=qwen2.5:7b
# NEMOCLAW_SANDBOX=harnesstest
# NEMOCLAW_AGENT=main
# NEMOCLAW_YES=1
# HARNESSTEST_NEMOCLAW_TIMEOUT=480
# DEEPSEEK_HARNESS_ROOT=
# DEEPSEEK_MODEL=
